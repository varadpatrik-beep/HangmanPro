<Window x:Class="HangmanPro.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hangman Pro | Kezdés" Width="550" Height="780" MinWidth="510" MinHeight="750"
        WindowStartupLocation="CenterScreen" Background="#0B1020" FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="InputBackground" Color="#151F35"/>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBackground}"/>
            <Setter Property="Foreground" Value="#F3F6FF"/>
            <Setter Property="CaretBrush" Value="#70E4D1"/>
            <Setter Property="BorderBrush" Value="#33435C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#E8F1FF"/>
            <Setter Property="Foreground" Value="#10182A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="MinHeight" Value="45"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#69E3CC"/>
            <Setter Property="Foreground" Value="#091525"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="54"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#91F1DF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#44BBA6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Border Background="#111A2D" CornerRadius="24" BorderThickness="1" BorderBrush="#293750" Padding="35">
            <StackPanel VerticalAlignment="Center">
                <Border Background="#1B3540" CornerRadius="12" HorizontalAlignment="Center" Padding="14,8" Margin="0,0,0,22">
                    <TextBlock Text="✦  WORD GAME  /  HUNGARIAN EDITION" Foreground="#81F0D9" FontSize="11" FontWeight="Bold"/>
                </Border>
                <TextBlock Text="HANGMAN" FontSize="50" FontWeight="ExtraBold" Foreground="#F8FAFF" HorizontalAlignment="Center"/>
                <TextBlock Text="PRO." FontSize="50" FontWeight="ExtraBold" Foreground="#69E3CC" HorizontalAlignment="Center" Margin="0,-12,0,6"/>
                <TextBlock Text="Találd ki a rejtett szót a saját tempódban!" FontSize="14" Foreground="#9EAFC8" HorizontalAlignment="Center" Margin="0,0,0,35"/>

                <TextBlock Text="JÁTÉKOS NEVE" FontSize="12" FontWeight="SemiBold" Foreground="#B9C9E0" Margin="0,0,0,9"/>
                <TextBox x:Name="PlayerNameBox" MaxLength="32" ToolTip="Üresen hagyva Vendég néven játszol." Margin="0,0,0,22"/>

                <TextBlock Text="KATEGÓRIA" FontSize="12" FontWeight="SemiBold" Foreground="#B9C9E0" Margin="0,0,0,9"/>
                <ComboBox x:Name="CategoryComboBox" SelectedIndex="0" Margin="0,0,0,22">
                    <ComboBoxItem Content="Általános IT"/>
                    <ComboBoxItem Content="Hardcore IT &amp; Hálózat"/>
                    <ComboBoxItem Content="Autószerelés &amp; Alkatrészek"/>
                    <ComboBoxItem Content="Életmód &amp; Egyéb"/>
                </ComboBox>

                <TextBlock Text="NEHÉZSÉGI SZINT" FontSize="12" FontWeight="SemiBold" Foreground="#B9C9E0" Margin="0,0,0,9"/>
                <ComboBox x:Name="DifficultyComboBox" SelectedIndex="1" Margin="0,0,0,22">
                    <ComboBoxItem Content="Könnyű  •  −2 mp / hiba"/>
                    <ComboBoxItem Content="Normál  •  −5 mp / hiba"/>
                    <ComboBoxItem Content="Hardcore  •  Nincs tipp, −10 mp / hiba"/>
                </ComboBox>

                <TextBlock Text="JÁTÉKIDŐ" FontSize="12" FontWeight="SemiBold" Foreground="#B9C9E0" Margin="0,0,0,9"/>
                <ComboBox x:Name="DurationComboBox" SelectedIndex="1" Margin="0,0,0,28">
                    <ComboBoxItem Content="3 perc"/>
                    <ComboBoxItem Content="5 perc (ajánlott)"/>
                    <ComboBoxItem Content="10 perc"/>
                    <ComboBoxItem Content="Időkorlát nélkül"/>
                </ComboBox>

                <Button Content="JÁTÉK INDÍTÁSA  →" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="StartGame_Click"/>
                <TextBlock Text="Egérrel és billentyűzettel is játszható" Foreground="#7488A5" FontSize="12" HorizontalAlignment="Center" Margin="0,22,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>