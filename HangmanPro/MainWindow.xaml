<Window x:Class="HangmanPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hangman Pro | Játék" Width="1170" Height="850" MinWidth="940" MinHeight="740"
        WindowStartupLocation="CenterScreen" Background="#0B1020" FontFamily="Segoe UI"
        PreviewTextInput="Window_PreviewTextInput">
    <Window.Resources>
        <Style x:Key="KeyboardBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="45"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#E8F1FF"/>
            <Setter Property="Background" Value="#25334D"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="10" BorderBrush="#354762" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#405574"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Padding" Value="26,0"/>
            <Setter Property="Background" Value="#69E3CC"/>
            <Setter Property="Foreground" Value="#0B1927"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#91F1DF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#223550"/>
            <Setter Property="Foreground" Value="#E7F1FF"/>
        </Style>
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="#111B30"/>
            <Setter Property="BorderBrush" Value="#2B3A56"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="20,13"/>
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9EAFCA"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F7FAFF"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
    </Window.Resources>
    <Grid Margin="30,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,23">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="HANGMAN  PRO." Foreground="#69E3CC" FontWeight="ExtraBold" FontSize="25"/>
                <TextBlock Text="Találd ki a rejtett szót!" Foreground="#9DACC4" FontSize="13" Margin="0,4,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#15243A" BorderBrush="#30415B" BorderThickness="1" CornerRadius="13" Padding="18,10" VerticalAlignment="Center">
                <TextBlock x:Name="PlayerInfoText" Foreground="#E6F2FF" FontSize="14" FontWeight="SemiBold"/>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="KATEGÓRIA:" Foreground="#91A6C3" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="ActiveCategoryText" Foreground="#69E3CC" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="↻  ÚJ JÁTÉK" Style="{StaticResource ActionButton}" Margin="0,0,10,0" Click="NewGame_Click"/>
                <Button Content="←  KEZDŐLAP" Style="{StaticResource SecondaryButton}" Click="Back_Click"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="PONTSZÁM" Style="{StaticResource StatLabel}"/>
                    <TextBlock x:Name="ScoreText" Text="0" Style="{StaticResource StatValue}" Foreground="#FFC978"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="HÁTRALÉVŐ IDŐ" Style="{StaticResource StatLabel}"/>
                    <TextBlock x:Name="TimeText" Text="05:00" Style="{StaticResource StatValue}" Foreground="#69E3CC"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="HIBÁK" Style="{StaticResource StatLabel}"/>
                    <TextBlock x:Name="MistakesText" Text="0 / 6" Style="{StaticResource StatValue}"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" CornerRadius="20" Background="#121D30" BorderBrush="#283851" BorderThickness="1" Padding="23">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="AKASZTÓFA" Foreground="#94A6C0" FontSize="12" FontWeight="Bold"/>
                    <Viewbox Grid.Row="2" Stretch="Uniform" MaxHeight="330">
                        <Canvas Width="210" Height="300">
                            <Line X1="10" Y1="290" X2="200" Y2="290" Stroke="#48607B" StrokeThickness="8" StrokeEndLineCap="Round" StrokeStartLineCap="Round"/>
                            <Line X1="52" Y1="290" X2="52" Y2="20" Stroke="#48607B" StrokeThickness="8" StrokeEndLineCap="Round" StrokeStartLineCap="Round"/>
                            <Line X1="48" Y1="20" X2="145" Y2="20" Stroke="#48607B" StrokeThickness="8" StrokeEndLineCap="Round" StrokeStartLineCap="Round"/>
                            <Line X1="145" Y1="18" X2="145" Y2="60" Stroke="#48607B" StrokeThickness="6" StrokeEndLineCap="Round"/>
                            <Ellipse x:Name="Part1_Head" Canvas.Left="120" Canvas.Top="60" Width="50" Height="50" Stroke="#69E3CC" StrokeThickness="6" Opacity="0" Visibility="Hidden"/>
                            <Line x:Name="Part2_Body" X1="145" Y1="110" X2="145" Y2="190" Stroke="#69E3CC" StrokeThickness="6" StrokeEndLineCap="Round" Opacity="0" Visibility="Hidden"/>
                            <Line x:Name="Part3_LeftArm" X1="145" Y1="130" X2="110" Y2="175" Stroke="#69E3CC" StrokeThickness="6" StrokeEndLineCap="Round" Opacity="0" Visibility="Hidden"/>
                            <Line x:Name="Part4_RightArm" X1="145" Y1="130" X2="180" Y2="175" Stroke="#69E3CC" StrokeThickness="6" StrokeEndLineCap="Round" Opacity="0" Visibility="Hidden"/>
                            <Line x:Name="Part5_LeftLeg" X1="145" Y1="186" X2="110" Y2="245" Stroke="#69E3CC" StrokeThickness="6" StrokeEndLineCap="Round" Opacity="0" Visibility="Hidden"/>
                            <Line x:Name="Part6_RightLeg" X1="145" Y1="186" X2="180" Y2="245" Stroke="#69E3CC" StrokeThickness="6" StrokeEndLineCap="Round" Opacity="0" Visibility="Hidden"/>
                        </Canvas>
                    </Viewbox>
                </Grid>
            </Border>
            <Border Grid.Column="2" CornerRadius="20" Background="#121D30" BorderBrush="#283851" BorderThickness="1" Padding="26,22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock Text="A KERESŐ SZÓ" Foreground="#91A6C3" FontSize="12" FontWeight="Bold"/>
                        <TextBlock x:Name="WordInfoText" Text="" Foreground="#8EA2C0" FontSize="12" Margin="0,6,0,0"/>
                    </StackPanel>
                    <ProgressBar Grid.Row="1" x:Name="TimeProgress" Height="9" Maximum="300" Value="300" Margin="0,18,0,17" Foreground="#69E3CC" Background="#25344C" BorderThickness="0"/>
                    <Border Grid.Row="2" Background="#1B2A42" CornerRadius="10" Padding="14,12" Margin="0,0,0,17">
                        <TextBlock x:Name="HintText" Foreground="#F5CA84" FontSize="14" TextWrapping="Wrap" TextAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Row="3" Margin="0,0,0,10">
                        <TextBlock Text="TALÁLD KI A SZÓT" Foreground="#91A6C3" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="WordDisplay" Foreground="#F8FAFF" FontSize="32" FontWeight="Bold" TextAlignment="Center" Margin="0,10,0,8" TextWrapping="Wrap"/>
                        <TextBlock x:Name="MessageText" Foreground="#69E3CC" FontSize="17" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" MinHeight="29"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Center">
                        <WrapPanel x:Name="KeyboardPanel" HorizontalAlignment="Center"/>
                    </ScrollViewer>
                    <TextBlock Grid.Row="5" Text="A helyes tipp minden előfordulást felfed." Foreground="#8297B5" TextAlignment="Center" Margin="0,14,0,0"/>
                </Grid>
            </Border>
        </Grid>
        <TextBlock Grid.Row="4" Text="BILLENTYŰZET: gépeld be a betűt, vagy kattints a virtuális billentyűkre   •   Minden téves tipp időbüntetéssel jár"
                   Foreground="#7789A4" FontSize="12" HorizontalAlignment="Center" Margin="0,18,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
    </Grid>
</Window>